# API runtime
NODE_ENV=development
# Defaults to the platform-provided PORT when present, otherwise 4000.
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/privaops

# Generate a unique secret with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Transactional account email (Resend). Required in production for verification/reset links.
RESEND_API_KEY=
EMAIL_FROM=PrivaOps <onboarding@resend.dev>
