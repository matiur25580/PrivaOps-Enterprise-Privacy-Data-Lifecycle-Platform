{
  "name": "privaops",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise privacy and data lifecycle operations platform",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm run dev --workspace @privaops/web\" \"npm run dev --workspace @privaops/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}